# Tactical RMM stack environment template. Copy to .env and edit.

# --- Image source -----------------------------------------------------------
# Set IMAGE_REPO to the registry prefix the images live under. The default in
# compose.yml is ghcr.io/niceguyit/. Use an empty string to consume locally
# built images (the tags produced by ./build.nu in each tactical-* directory).
IMAGE_REPO=ghcr.io/niceguyit/
VERSION=1.5.1

# --- Hostnames --------------------------------------------------------------
APP_HOST=rmm.example.com
API_HOST=api.example.com
MESH_HOST=mesh.example.com
CSRF_COOKIE_DOMAIN=example.com
SESSION_COOKIE_DOMAIN=example.com

# --- TRMM admin -------------------------------------------------------------
TRMM_USER=tactical
TRMM_PASS=change_me_strong_password

# --- MeshCentral admin ------------------------------------------------------
MESH_USER=tactical
MESH_PASS=change_me_strong_password

# --- Databases --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASS=change_me_strong_password
# MeshCentral data store. Leave MESH_POSTGRES_HOST empty (the default) to use
# MeshCentral's built-in NeDB store, which needs no external database. Set
# MESH_POSTGRES_HOST (and the credentials below) to store MeshCentral data in
# PostgreSQL instead, as staging and production do. The mesh database is separate
# from the tacticalrmm database above and needs its own database, user, and
# password provisioned on the target server.
MESH_POSTGRES_HOST=
MESH_POSTGRES_PORT=5432
MESH_POSTGRES_USER=meshcentral
MESH_POSTGRES_PASS=change_me_strong_password
MESH_POSTGRES_DATABASE=meshcentral
MESH_PERSISTENT_CONFIG=0

# --- Feature toggles --------------------------------------------------------
TRMM_DISABLE_WEB_TERMINAL=False
TRMM_DISABLE_SERVER_SCRIPTS=False
TRMM_DISABLE_SSO=False

# --- HTTP / HTTPS ports -----------------------------------------------------
TRMM_HTTP_PORT=80
TRMM_HTTPS_PORT=443

# --- TLS certificates -------------------------------------------------------
# Base64-encoded PEM cert and key. Leave empty to have tactical-nginx
# auto-generate a self-signed wildcard cert on first run.
CERT_PUB_KEY=
CERT_PRIV_KEY=
