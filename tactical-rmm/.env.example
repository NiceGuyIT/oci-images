# Tactical RMM stack environment template. Copy to .env and edit.

# The Django tree is baked into the backend image at /opt/tactical and is not a
# volume; only mutable state is mounted. A deployment created before this layout
# keeps everything in one tactical-data volume and will not start: the entrypoint
# aborts with a pointer to the migration steps in the repository README.
#
# Nothing in the stack runs as root, so a bind-mounted host directory must already
# be owned by uid 1000. Named volumes are seeded from the image and need nothing.

# --- Image source -----------------------------------------------------------
# Set IMAGE_REPO to the registry prefix the images live under. The default in
# compose.yml is ghcr.io/niceguyit/. Use an empty string to consume locally
# built images (the tags produced by ./build.nu in each tactical-* directory).
IMAGE_REPO=ghcr.io/niceguyit/
# Our image version first, then the upstream Tactical RMM release it packages.
# The two move independently: v1.0.1-trmm1.5.1 is a change to these images with
# no upstream change. Also valid, in increasing looseness: v1.0-trmm1.5.1,
# v1-trmm1.5.1, latest-trmm1.5.1 (newest packaging of that upstream release) and
# latest. Pin the full version in production so a rebuild cannot move under you.
VERSION=v1.0.0-trmm1.5.1

# --- Hostnames --------------------------------------------------------------
APP_HOST=rmm.example.com
API_HOST=api.example.com
MESH_HOST=mesh.example.com
CSRF_COOKIE_DOMAIN=example.com
SESSION_COOKIE_DOMAIN=example.com

# --- TRMM admin -------------------------------------------------------------
TRMM_USER=tactical
TRMM_PASS=change_me_strong_password

# --- MeshCentral admin ------------------------------------------------------
MESH_USER=tactical
MESH_PASS=change_me_strong_password

# --- Databases --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASS=change_me_strong_password
# MeshCentral stores its data in PostgreSQL (the only supported data store). The
# mesh database is separate from the tacticalrmm database above but lives on the
# same PostgreSQL server; tactical-init creates the mesh database and role
# automatically (using POSTGRES_USER/POSTGRES_PASS as the admin). MESH_POSTGRES_HOST
# defaults to tactical-postgres and normally does not need changing.
MESH_POSTGRES_HOST=tactical-postgres
MESH_POSTGRES_PORT=5432
MESH_POSTGRES_USER=meshcentral
MESH_POSTGRES_PASS=change_me_strong_password
MESH_POSTGRES_DATABASE=meshcentral
# 1 (the default) seeds MeshCentral's config.json only when absent, so edits to
# it survive a restart. 0 rewrites it from the template on every start. Because a
# persistent config.json pins the MeshCentral database credentials and hostnames
# it was seeded with, changing MESH_POSTGRES_PASS, MESH_HOST or the SMTP settings
# below means editing config.json or setting this to 0 for one restart.
MESH_PERSISTENT_CONFIG=1

# --- Configuration persistence ----------------------------------------------
# 1 (the default) seeds conf/app.ini and conf/local_settings.py only when they
# are absent, so your edits survive a restart. 0 makes tactical-init regenerate
# both on every run, which is what upstream does; use it once to pick up a new
# template or to re-randomize SECRET_KEY, then set it back to 1.
TRMM_PERSISTENT_CONFIG=1

# Each Django service runs a startup bootstrap, serialized by a PostgreSQL
# advisory lock. It runs the full install sequence on a first run and whenever
# the image's Tactical RMM version or on-disk layout changes; otherwise it runs a
# short path and finishes in seconds. Set to 1 to force the full sequence on the
# next start.
TRMM_FORCE_INIT=0

# --- Feature toggles --------------------------------------------------------
TRMM_DISABLE_WEB_TERMINAL=False
TRMM_DISABLE_SERVER_SCRIPTS=False
TRMM_DISABLE_SSO=False

# --- HTTP / HTTPS ports -----------------------------------------------------
TRMM_HTTP_PORT=80
TRMM_HTTPS_PORT=443

# --- TLS certificates -------------------------------------------------------
# Base64-encoded PEM cert and key. Leave empty to have tactical-nginx
# auto-generate a self-signed wildcard cert on first run.
CERT_PUB_KEY=
CERT_PRIV_KEY=
